formulas:
  status_rank: if(status == "active", 1, if(status == "queued", 2, if(status == "parked", 3, if(status == "done", 4, 5))))
  Untitled: ""
  card_title: title
  card_priority: priority
  card_project: project
  card_lead: lead
  lane_sort: if(status == "done", "", priority)
  lane: if(status == "queued", "1 Queued", if(status == "active", "2 Active", if(status == "parked", "3 Parked", "4 Done")))
  lane_created: if(status == "queued", created, if(status == "parked", created, ""))
  lane_recent: if(status == "queued", "", if(status == "parked", "", file.mtime))
properties:
  file.name:
    displayName: Ticket
  project:
    displayName: Project
  status:
    displayName: Status
  priority:
    displayName: P
  parked_until:
    displayName: Until
  parked_reason:
    displayName: Why
  pr_state:
    displayName: Landing
  title:
    displayName: Title
  lead:
    displayName: Lead
  origin:
    displayName: Origin
  proposed_by:
    displayName: Proposed by
  created:
    displayName: Created
  file.mtime:
    displayName: Updated
  formula.card_title:
    displayName: Title
  formula.card_priority:
    displayName: P
  formula.card_project:
    displayName: Project
  formula.card_lead:
    displayName: Lead
views:
  - type: notion-board
    name: Kanban
    filters:
      and:
        - not:
            - file.inFolder("ledger/_templates")
            - not:
                - status != "done"
                - file.mtime >= today()
        - file.inFolder("ledger/tickets")
        - status != "declined"
    groupBy:
      property: formula.lane
      direction: ASC
    order:
      - file.name
      - formula.card_title
      - formula.card_priority
      - formula.card_project
      - formula.card_lead
    sort:
      - property: formula.lane_sort
        direction: ASC
      - property: formula.lane_created
        direction: ASC
      - property: formula.lane_recent
        direction: DESC
      - property: file.name
        direction: ASC
    openMode: tab
    pillProperties:
      - card_priority
      - card_project
      - project
    pinnedColors:
      - 1 Queued=yellow
      - 2 Active=green
      - 3 Parked=red
      - 4 Done=gray
      - P0=purple
      - P1=red
      - P2=orange
      - P3=yellow
      - badtakes=blue
      - spud=purple
  - type: bases
    name: By project
    filters:
      and:
        - not:
            - file.inFolder("ledger/_templates")
        - file.inFolder("ledger/tickets")
        - '!status.containsAny("done", "declined")'
    groupBy:
      property: project
      direction: ASC
    order:
      - file.name
      - status
      - priority
      - title
      - lead
      - proposed_by
      - origin
      - created
      - tags
    sort:
      - property: status
        direction: ASC
      - property: priority
        direction: ASC
      - property: file.name
        direction: ASC
      - property: formula.status_rank
        direction: ASC
    columnSize:
      note.project: 103
      note.status: 76
      note.priority: 66
      note.title: 493
      note.lead: 140
      note.proposed_by: 146
    pillProperties:
      - status
      - priority
    verticalLines: true
    pinnedColors:
      - parked=red
      - queued=yellow
      - active=green
      - P1=red
      - P2=orange
      - P3=yellow
    columnWidths:
      note.title: 386.0078125
    columnNames: {}
  - type: table
    name: Board
    filters:
      and:
        - not:
            - file.inFolder("ledger/_templates")
        - file.inFolder("ledger/tickets")
        - status != "done"
        - status != "parked"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - project
      - status
      - pr_state
      - priority
      - title
      - lead
      - origin
      - proposed_by
      - created
    sort:
      - property: priority
        direction: ASC
      - property: status
        direction: DESC
      - property: file.name
        direction: ASC
      - property: formula.status_rank
        direction: ASC
    columnSize:
      note.title: 673
      note.lead: 193
      note.proposed_by: 146
      note.pr_state: 90
    pillProperties:
      - pr_state
    pinnedColors:
      - merged=red
      - open=yellow
      - closed=gray
  - type: table
    name: Parked
    filters:
      and:
        - not:
            - file.inFolder("ledger/_templates")
        - file.inFolder("ledger/tickets")
        - status == "parked"
    groupBy:
      property: project
      direction: ASC
    order:
      - file.name
      - project
      - priority
      - title
      - parked_until
      - parked_reason
      - lead
      - created
    sort:
      - property: priority
        direction: ASC
      - property: parked_until
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      note.title: 420
      note.parked_reason: 360
      note.lead: 140
  - type: table
    name: Reports
    filters:
      and:
        - file.inFolder("reports")
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.name
        direction: DESC
  - type: table
    name: Closed
    filters:
      and:
        - not:
            - file.inFolder("ledger/_templates")
        - file.inFolder("ledger/tickets")
        - status == "done"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - project
      - status
      - priority
      - title
      - lead
      - origin
      - proposed_by
      - created
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
      - property: priority
        direction: ASC
      - property: status
        direction: DESC
      - property: file.name
        direction: ASC
      - property: formula.status_rank
        direction: ASC
    columnSize:
      note.lead: 167
      note.proposed_by: 146
