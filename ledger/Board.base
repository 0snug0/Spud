formulas:
  status_rank: if(status == "active", 1, if(status == "queued", 2, if(status == "done", 3, 4)))
properties:
  file.name:
    displayName: Ticket
  status:
    displayName: Status
  priority:
    displayName: P
  title:
    displayName: Title
  lead:
    displayName: Lead
  origin:
    displayName: Origin
  proposed_by:
    displayName: Proposed by
  created:
    displayName: Created
  file.mtime:
    displayName: Updated
views:
  - type: table
    name: Board
    filters:
      and:
        - not:
            - file.inFolder("ledger/_templates")
        - file.inFolder("ledger/tickets")
        - status != "done"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - priority
      - title
      - lead
      - origin
      - proposed_by
      - created
    sort:
      - property: status
        direction: DESC
      - property: file.name
        direction: ASC
      - property: formula.status_rank
        direction: ASC
      - property: priority
        direction: ASC
    columnSize:
      note.lead: 193
  - type: table
    name: Reports
    filters:
      and:
        - file.inFolder("reports")
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.name
        direction: DESC
