formulas:
  status_rank: 'if(status == "active", 1, if(status == "queued", 2, if(status == "done", 3, 4)))'
properties:
  file.name:
    displayName: Ticket
  status:
    displayName: Status
  priority:
    displayName: P
  title:
    displayName: Title
  lead:
    displayName: Lead
  origin:
    displayName: Origin
  proposed_by:
    displayName: Proposed by
  created:
    displayName: Created
  file.mtime:
    displayName: Updated
views:
  - type: table
    name: Board
    filters:
      and:
        - file.hasTag("ticket")
        - not:
            - file.inFolder("ledger/_templates")
    order:
      - file.name
      - status
      - priority
      - title
      - lead
      - origin
      - proposed_by
      - created
    sort:
      - property: formula.status_rank
        direction: ASC
      - property: priority
        direction: ASC
      - property: file.name
        direction: DESC
  - type: table
    name: Reports
    filters:
      and:
        - file.inFolder("reports")
    order:
      - file.name
      - file.mtime
    sort:
      - property: file.name
        direction: DESC
